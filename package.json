{
  "name": "redline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w packages/reviewer && npm run typecheck -w packages/eval && npm run typecheck -w apps/server",
    "eval": "npm run eval -w packages/eval",
    "start": "npm run start -w apps/server"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "diff": "^7.0.0",
    "@types/diff": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}