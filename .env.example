# Copy this to .env (gitignored) and fill in what you use. Never commit the real file.
# Pick ONE way to get a model:

# 1. Gemini: free, needs a free key from https://aistudio.google.com/apikey (no card)
GEMINI_API_KEY=
# REDLINE_MODEL=gemini-flash-latest        (list the ones your key can use: npm run models)

# 2. Ollama: free, runs on your machine, needs no key. Install it, then: ollama pull qwen2.5-coder:3b
# REDLINE_PROVIDER=ollama
# REDLINE_MODEL=qwen2.5-coder:3b
# OLLAMA_NUM_CTX=16384                      (context window; bigger uses more memory)

# 3. Anthropic: paid
# ANTHROPIC_API_KEY=

# --- only for the self-hosted GitHub App server (apps/server), not the Action ---
# GITHUB_APP_ID=
# GITHUB_PRIVATE_KEY=                       (the .pem with each line break written as \n)
# GITHUB_WEBHOOK_SECRET=
# ALLOWED_OWNERS=                           (comma separated; only these accounts' repos are reviewed)
