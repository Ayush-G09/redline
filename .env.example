# Copy this to .env (gitignored) and fill it in. Never commit the real file.

# --- language model ---
ANTHROPIC_API_KEY=
# REDLINE_MODEL=claude-sonnet-5

# --- GitHub App (see README, "Create the GitHub App") ---
GITHUB_APP_ID=
# The .pem you download, with each line break written as \n so it fits on one line
GITHUB_PRIVATE_KEY=
# The webhook secret you chose when creating the app
GITHUB_WEBHOOK_SECRET=
# Only repositories owned by these accounts are ever reviewed (comma separated). Required: reviews cost money.
ALLOWED_OWNERS=

# --- optional ---
# PORT=3200
# CONCURRENCY=2
# POST_CLEAN=true                     post a short review even when nothing is found
# MAX_FILES=150                       skip changes touching more files than this
# MAX_REVIEWS_PER_PR_PER_HOUR=12
